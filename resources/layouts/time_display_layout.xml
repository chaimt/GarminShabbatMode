    <label id="CurrentTime"    x="center" y="33%" font="Graphics.FONT_LARGE"  color="Graphics.COLOR_WHITE"   justification="Graphics.TEXT_JUSTIFY_CENTER" text="--:--:--"/>
    <label id="SunriseSunset"  x="center" y="55%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="--:-- / --:--"/>
    <label id="CandleLight"    x="center" y="77%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_ORANGE"  justification="Graphics.TEXT_JUSTIFY_CENTER" text="--:--"/>
    <label id="ShabbatEnd"     x="center" y="88%" font="Graphics.FONT_TINY"   color="Graphics.COLOR_BLUE"    justification="Graphics.TEXT_JUSTIFY_CENTER" text="--:--"/>
</layout>
