<?xml version="1.0" encoding="UTF-8"?>
<!-- Layout reference for TimeSettingsView (programmatic drawing only) -->
<layout id="TimeSettingsLayout">
    <label id="SettingsTitle"    x="center" y="10%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_WHITE"   justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.SettingsTitle"/>
    <label id="CandleOffset"     x="center" y="30%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.CandleOffsetLabel"/>
    <label id="EndOffset"        x="center" y="45%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.EndOffsetLabel"/>
    <label id="RabbenuTam"       x="center" y="60%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.RabbenuTamLabel"/>
    <label id="TimeFormatLabel"  x="center" y="75%" font="Graphics.FONT_SMALL"  color="Graphics.COLOR_LT_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.TimeFormatLabel"/>
    <label id="SettingsHint"     x="center" y="92%" font="Graphics.FONT_TINY"   color="Graphics.COLOR_DK_GRAY" justification="Graphics.TEXT_JUSTIFY_CENTER" text="SELECT: change  BACK: exit"/>
</layout>
