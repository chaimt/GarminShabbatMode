<?xml version="1.0" encoding="UTF-8"?>
<layout id="MainLayout">
    <label id="AppTitle" x="center" y="25%" color="Graphics.COLOR_WHITE" font="Graphics.FONT_LARGE" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.AppName"/>

    <label id="CurrentTime" x="center" y="50%" color="Graphics.COLOR_LT_GRAY" font="Graphics.FONT_LARGE" justification="Graphics.TEXT_JUSTIFY_CENTER" text="--:--:--"/>

    <label id="StatusMessage" x="center" y="75%" color="Graphics.COLOR_GREEN" font="Graphics.FONT_MEDIUM" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.Ready"/>

    <label id="FirstRunMessage" x="center" y="85%" color="Graphics.COLOR_YELLOW" font="Graphics.FONT_SMALL" justification="Graphics.TEXT_JUSTIFY_CENTER" text="@Strings.FirstRunMessage" locY="85%"/>
</layout>